# PostgreSQL Supabase interne. Encoder les caractères spéciaux du mot de passe dans l'URL.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:CHANGE_ME@db:5432/postgres?schema=public

# Garde-fou de migration Prisma (hardening/prisma-migration-guard) — jamais
# des identifiants : uniquement l'hôte et le nom de base que DATABASE_URL et
# DIRECT_URL doivent réellement pointer, vérifiés par
# scripts/safe-prisma-migrate.cjs avant tout `prisma migrate deploy`. Voir
# docs/PRISMA_MIGRATION_GUARD.md. Les deux variables ci-dessous sont les
# SEULES que ce garde-fou lit depuis ce fichier : MIGRATION_ENVIRONMENT=production
# est déjà fixé dans docker-compose.production.yml (jamais lu depuis
# .env.production) car ce Compose EST le déploiement de production — il n'y a
# donc rien d'autre à définir ici pour autoriser la base "postgres" (nom
# générique aussi utilisé par les bases techniques de PostgreSQL).
EXPECTED_DATABASE_HOST=db
EXPECTED_DATABASE_NAME=postgres

# API NestJS
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=7d
FRONTEND_URLS=https://app.robiacopilot.site,https://robiacopilot.site

# Moteur IA : groq ou claude
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/Qwen3.8-27B
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Google PageSpeed Insights (optionnelle). Sans clé, l'audit interroge
# quand même PSI (quota public plus limité) plutôt que de l'ignorer.
# Le contrôle de performance n'est marqué "non testé" qu'en cas
# d'échec réel de l'appel (réseau, timeout, quota, réponse invalide).
GOOGLE_PAGESPEED_API_KEY=

# Récupération de mot de passe par SMTP (ne jamais versionner le vrai mot de passe)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=no-reply@robiacopilot.site
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@robiacopilot.site
PASSWORD_RESET_URL=https://app.robiacopilot.site/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# Dispatcher générique RC26 (indépendant du choix du fournisseur audit).
NOTIFICATIONS_ENABLED=false
# n8n reste responsable de l'email audit et de ses opportunités.
# Migration vers notifications différée jusqu'à un workflow ordonné validé.
AUDIT_COMPLETED_EMAIL_PROVIDER=n8n

# Automatisations n8n (le secret doit être identique au credential Header Auth)
N8N_WEBHOOK_BASE_URL=https://n8n.robiacopilot.site/webhook
N8N_WEBHOOK_SECRET=CHANGE_ME_WITH_64_RANDOM_HEXADECIMAL_CHARACTERS
N8N_WEBHOOK_TIMEOUT_MS=5000
DASHBOARD_URL=https://app.robiacopilot.site

# Google Search Console + Analytics OAuth (lecture seule)
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
GOOGLE_OAUTH_REDIRECT_URI=https://api.robiacopilot.site/integrations/google/search-console/callback
# Ajouter également cette URI exacte au même client OAuth Google.
GOOGLE_BUSINESS_PROFILE_REDIRECT_URI=https://api.robiacopilot.site/integrations/google/business-profile/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=CHANGE_ME_WITH_64_RANDOM_HEXADECIMAL_CHARACTERS
GOOGLE_OAUTH_STATE_SECRET=CHANGE_ME_WITH_64_RANDOM_HEXADECIMAL_CHARACTERS
GOOGLE_SEARCH_CONSOLE_TIMEOUT_MS=10000
GOOGLE_BUSINESS_PROFILE_TIMEOUT_MS=10000

# Meta / Facebook / Instagram (RC18, lecture seule)
META_APP_ID=CHANGE_ME
META_APP_SECRET=CHANGE_ME
META_OAUTH_REDIRECT_URI=https://api.robiacopilot.site/integrations/meta/callback
META_TOKEN_ENCRYPTION_KEY=CHANGE_ME_WITH_64_RANDOM_HEXADECIMAL_CHARACTERS
META_OAUTH_STATE_SECRET=CHANGE_ME_WITH_64_RANDOM_HEXADECIMAL_CHARACTERS
META_GRAPH_API_VERSION=v26.0
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,instagram_basic
META_GRAPH_TIMEOUT_MS=10000

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=price_1UE4nWQ07JsOGT6XQeAedjPX
STRIPE_PRICE_PRO_ANNUAL=price_1UE4nbQ07JsOGT6XMa3DyLRc
STRIPE_TRIAL_DAYS=14

# Observabilité (RC-15). LOG_LEVEL par défaut "info" si absent.
# SENTRY_DSN optionnelle : sans elle, aucune erreur n'est envoyée à Sentry.
LOG_LEVEL=info
SENTRY_DSN=
