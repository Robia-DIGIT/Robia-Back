# PostgreSQL Supabase interne. Encoder les caractères spéciaux du mot de passe dans l'URL.
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:CHANGE_ME@db:5432/postgres?schema=public

# API NestJS
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRES_IN=7d
FRONTEND_URLS=https://app.robiacopilot.site,https://robiacopilot.site

# Moteur IA : groq ou claude
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
