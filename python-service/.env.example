# Select the active LLM provider: groq or claude
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/Qwen3.8-27B

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Google PageSpeed Insights (optional). PSI accepts unauthenticated
# requests at a lower quota, so when this is unset the audit still
# calls PSI without a key rather than skipping it. The performance
# finding only falls back to "not_tested" if the call actually fails
# (network error, timeout, quota, malformed response).
# https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY=
