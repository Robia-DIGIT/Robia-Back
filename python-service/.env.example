# Select the active LLM provider: groq or claude
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL=qwen/Qwen3.8-27B

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Google PageSpeed Insights (optional). When unset, the performance
# finding is reported as "not_tested" instead of failing the audit.
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
