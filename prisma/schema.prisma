// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
  //directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  provider     String   @default("email")
  phone        String?
  company      String?
  bio          String?
  createdAt    DateTime @default(now()) @map("created_at")

  organizations Organization[]
  validationLogs ValidationLog[]

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  sector    String?
  city      String?
  country   String?
  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id])
  websites  Website[]
  audits    Audit[]
  opportunities Opportunity[]
  documents     Document[]
  validationLogs ValidationLog[]
  actionItems    ActionItem[]
  locations Location[] 
  createdAt DateTime @default(now()) @map("created_at")

  @@map("organizations")
}

model Website {
  id            String   @id @default(cuid())
  organizationId String  @map("organization_id")
  organization  Organization @relation(fields: [organizationId], references: [id])
  url           String
  domain        String?
  status        String   @default("pending") // pending | valid | unreachable
  lastCheckedAt DateTime? @map("last_checked_at")
  createdAt     DateTime @default(now()) @map("created_at")

  audits Audit[]
  pages WebPage[]

  @@unique([organizationId, url])
  @@map("websites")  
}

model WebPage {
  id          String   @id @default(cuid())
  websiteId   String   @map("website_id")
  website     Website  @relation(fields: [websiteId], references: [id])

  url         String
  path        String?
  status      String   @default("pending") // pending | crawled | failed | excluded
  httpStatus  Int?     @map("http_status")

  title       String?
  metaDescription String? @map("meta_description")

  h1          Json?
  h2          Json?
  h3          Json?

  canonical   String?
  metaRobots  String? @map("meta_robots")

  wordCount   Int?     @map("word_count")

  imagesCount      Int? @map("images_count")
  imagesWithoutAlt Int? @map("images_without_alt")

  internalLinksCount Int? @map("internal_links_count")
  externalLinksCount Int? @map("external_links_count")

  structuredDataTypes Json? @map("structured_data_types")
  ogTagsPresent      Json? @map("og_tags_present")
  topKeywords        Json? @map("top_keywords")

  businessAddress   String? @map("business_address")
  businessLatitude  Float?  @map("business_latitude")
  businessLongitude Float?  @map("business_longitude")

  socialLinks Json? @map("social_links")

  jsRenderingUsed      Boolean @default(false) @map("js_rendering_used")
  jsRenderingSuspected Boolean @default(false) @map("js_rendering_suspected")

  mainContent String? @map("main_content")

  errorMessage String? @map("error_message")

  crawledAt DateTime? @map("crawled_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([websiteId, url])
  @@index([websiteId])
  @@map("web_pages")
}

model Audit {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  websiteId      String    @map("website_id")
  website        Website   @relation(fields: [websiteId], references: [id])
  locationId     String?   @map("location_id")
  location       Location? @relation(fields: [locationId], references: [id])
  status         String    @default("pending") // pending | running | completed | failed
  opportunities Opportunity[]
  globalScore    Int?      @map("global_score")
  resultJson     Json?     @map("result_json")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  @@map("audits")
}

model Opportunity {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  auditId          String   @map("audit_id")
  audit            Audit    @relation(fields: [auditId], references: [id])
  locationId       String?  @map("location_id")
  location         Location? @relation(fields: [locationId], references: [id])
  title            String
  description      String
  category         String?
  impactScore      Int      @map("impact_score")
  effortScore      Int      @map("effort_score")
  confidenceScore  Float    @map("confidence_score")
  sourceData       Json?    @map("source_data")
  status           String   @default("open") // open | in_progress | done | ignored
  createdAt        DateTime @default(now()) @map("created_at")

  documents Document[]
  actionItems ActionItem[]

  @@map("opportunities")
}

model Document {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  opportunityId  String   @map("opportunity_id")
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  type           String   // local_page | faq | meta | gbp_post | review_reply | dev_brief | checklist
  title          String
  content        String
  status         String   @default("draft") // draft | edited | validated
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  validationLogs ValidationLog[]
  actionItems    ActionItem[]

  @@map("documents")
}

model ValidationLog {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  documentId     String    @map("document_id")
  document       Document  @relation(fields: [documentId], references: [id])
  actionType     String    @map("action_type") // publish | update | reply
  platform       String?   // website | gbp | wordpress...
  beforeValue    String?   @map("before_value")
  afterValue     String?   @map("after_value")
  status         String    @default("pending") // pending | approved | rejected
  validatedAt    DateTime? @map("validated_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("validation_logs")
}

model ActionItem {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  opportunityId  String?   @map("opportunity_id")
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  documentId     String?   @map("document_id")
  document       Document? @relation(fields: [documentId], references: [id])
  title          String
  status         String    @default("todo") // todo | in_progress | done | blocked | ignored
  dueDate        DateTime? @map("due_date")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("action_items")
}

model Location {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String   // ex: "Orange Analakely"
  address        String?
  city           String?
  country        String?
  latitude       Float?
  longitude      Float?

  // Horaires normaux + exceptions (jours fériés, fermetures ponctuelles)
  // structure libre en JSON pour l'instant, à typer plus tard si besoin
  openingHours   Json?    @map("opening_hours")

  isPrimary      Boolean  @default(true) @map("is_primary")
  status         String   @default("active") // active | inactive

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  audits         Audit[]
  opportunities  Opportunity[]

  @@map("locations")
}