// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
  //directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String?  @map("password_hash")
  provider     String   @default("email")
  phone        String?
  company      String?
  bio          String?
  createdAt    DateTime @default(now()) @map("created_at")
  tokenVersion Int      @default(0) @map("token_version")

  organizations Organization[]
  validationLogs ValidationLog[]
  passwordResetTokens PasswordResetToken[]
  createdAutomations      Automation[]
  triggeredAutomationRuns AutomationRun[] @relation("AutomationRunTriggeredBy")
  approvedAutomationRuns  AutomationRun[] @relation("AutomationRunApprovedBy")
  // RC-26: a user is only ever the *recipient* of a notification when
  // resolved server-side from Automation.createdById — never from a
  // caller-supplied address (see OpsActionsRegistryService's
  // robia.notification.send_email).
  notificationDeliveries  NotificationDelivery[]
  // RC-29 — the human who decided an ODC candidature (decide()'s own
  // decidedById). No relation exists for OdcProgram.createdById or
  // OdcHistoryEvent.actorUserId: those stay plain, unrelated ids, per the
  // ODC spec's own Prisma sketch.
  odcApplicationsDecided  OdcApplication[]
  odcOutreachesApproved   OdcOutreach[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  sector    String?
  city      String?
  country   String?
  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id])
  websites  Website[]
  audits    Audit[]
  opportunities Opportunity[]
  documents     Document[]
  validationLogs ValidationLog[]
  actionItems    ActionItem[]
  actionExecutionEvents ActionExecutionEvent[]
  locations Location[]
  googleSearchConsoleConnection GoogleSearchConsoleConnection?
  googleBusinessProfileConnection GoogleBusinessProfileConnection?
  googleBusinessProfileLocations GoogleBusinessProfileLocation[]
  metaConnection MetaConnection?
  stripeSubscription StripeSubscription?
  automations       Automation[]
  automationRuns    AutomationRun[]
  automationEvents  AutomationEvent[]
  competitors       Competitor[]
  notificationDeliveries NotificationDelivery[]
  odcPrograms       OdcProgram[]
  odcApplicants     OdcApplicant[]
  odcApplications   OdcApplication[]
  odcOutreaches     OdcOutreach[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("organizations")
}

model StripeSubscription {
  id                   String   @id @default(cuid())
  organizationId       String   @unique @map("organization_id")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?  @unique @map("stripe_customer_id")
  stripeSubscriptionId String?  @unique @map("stripe_subscription_id")
  stripePriceId        String?  @map("stripe_price_id")
  plan                 String   @default("starter")
  status               String   @default("inactive")
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean  @default(false) @map("cancel_at_period_end")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("stripe_subscriptions")
}

model GoogleSearchConsoleConnection {
  id                    String   @id @default(cuid())
  organizationId        String   @unique @map("organization_id")
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  googleAccountEmail    String?  @map("google_account_email")
  encryptedRefreshToken String   @map("encrypted_refresh_token")
  grantedScopes         String?  @map("granted_scopes")
  selectedSiteUrl       String?  @map("selected_site_url")
  permissionLevel       String?  @map("permission_level")
  selectedAnalyticsPropertyId   String?  @map("selected_analytics_property_id")
  selectedAnalyticsPropertyName String?  @map("selected_analytics_property_name")
  connectedAt           DateTime @default(now()) @map("connected_at")
  lastSyncedAt          DateTime? @map("last_synced_at")
  lastAnalyticsSyncedAt DateTime? @map("last_analytics_synced_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  dailyMetrics          GoogleSearchConsoleDailyMetric[]

  @@map("google_search_console_connections")
}

model GoogleSearchConsoleDailyMetric {
  id           String   @id @default(cuid())
  connectionId String   @map("connection_id")
  connection   GoogleSearchConsoleConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  clicks       Float
  impressions  Float
  ctr          Float
  position     Float
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([connectionId, date])
  @@index([connectionId, date])
  @@map("google_search_console_daily_metrics")
}

model GoogleBusinessProfileConnection {
  id                    String   @id @default(cuid())
  organizationId        String   @unique @map("organization_id")
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  googleAccountEmail    String?  @map("google_account_email")
  googleAccountSubject  String?  @map("google_account_subject")
  encryptedRefreshToken String   @map("encrypted_refresh_token")
  grantedScopes         String?  @map("granted_scopes")
  connectedAt           DateTime @default(now()) @map("connected_at")
  lastSyncedAt          DateTime? @map("last_synced_at")
  lastSyncAttemptAt     DateTime? @map("last_sync_attempt_at")
  lastSyncStatus        String   @default("never") @map("last_sync_status") // never | running | success | partial | failed
  syncClaimedAt         DateTime? @map("sync_claimed_at")
  syncClaimToken        String?  @map("sync_claim_token")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  locations             GoogleBusinessProfileLocation[]

  @@map("google_business_profile_connections")
}

// Read-only mirror of locations returned by the Business Profile APIs.
// Google remains the source of truth; ROBIA only stores the fields required
// to display and map an establishment to its internal Location record.
model GoogleBusinessProfileLocation {
  id                 String   @id @default(cuid())
  organizationId     String   @map("organization_id")
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId       String   @map("connection_id")
  connection         GoogleBusinessProfileConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  googleAccountName  String   @map("google_account_name")
  accountDisplayName String?  @map("account_display_name")
  googleLocationName String   @map("google_location_name")
  languageCode       String?  @map("language_code")
  title              String
  storeCode          String?  @map("store_code")
  address            Json?
  primaryPhone       String?  @map("primary_phone")
  additionalPhones   String[] @default([]) @map("additional_phones")
  websiteUri         String?  @map("website_uri")
  primaryCategory    String?  @map("primary_category")
  additionalCategories String[] @default([]) @map("additional_categories")
  description        String?
  // RC-38 "fiche complète" — the rest of what Google's Business Information
  // API returns for a location, kept as the API's own JSON shape rather
  // than flattened into columns: regularHours/specialHours/moreHours are
  // display-only (never computed against, never queried by field), so
  // there is nothing to gain from normalizing their internal structure.
  regularHours       Json?    @map("regular_hours")
  specialHours       Json?    @map("special_hours")
  moreHours          Json?    @map("more_hours")
  serviceArea        Json?    @map("service_area")
  labels             String[] @default([])
  latitude           Float?
  longitude          Float?
  openStatus         String?  @map("open_status") // OPEN | CLOSED_PERMANENTLY | CLOSED_TEMPORARILY
  metadata           Json?
  robiaLocationId    String?  @map("robia_location_id")
  robiaLocation      Location? @relation(fields: [robiaLocationId], references: [id], onDelete: SetNull)
  lastSyncedAt       DateTime @map("last_synced_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([connectionId, googleLocationName])
  @@index([organizationId, lastSyncedAt])
  @@index([robiaLocationId])
  @@map("google_business_profile_locations")
}

model MetaConnection {
  id                         String   @id @default(cuid())
  organizationId             String   @unique @map("organization_id")
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metaUserId                 String?  @map("meta_user_id")
  metaUserName               String?  @map("meta_user_name")
  encryptedUserAccessToken   String   @map("encrypted_user_access_token")
  grantedScopes              String?  @map("granted_scopes")
  selectedPageId             String?  @map("selected_page_id")
  selectedPageName           String?  @map("selected_page_name")
  encryptedPageAccessToken   String?  @map("encrypted_page_access_token")
  selectedInstagramAccountId String?  @map("selected_instagram_account_id")
  selectedInstagramUsername  String?  @map("selected_instagram_username")
  connectedAt                DateTime @default(now()) @map("connected_at")
  lastSyncedAt               DateTime? @map("last_synced_at")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  @@map("meta_connections")
}

model Website {
  id            String   @id @default(cuid())
  organizationId String  @map("organization_id")
  organization  Organization @relation(fields: [organizationId], references: [id])
  url           String
  domain        String?
  status        String   @default("pending") // pending | valid | unreachable
  lastCheckedAt DateTime? @map("last_checked_at")
  createdAt     DateTime @default(now()) @map("created_at")

  audits Audit[]
  pages WebPage[]
  competitors Competitor[]
  documents Document[]

  @@unique([organizationId, url])
  @@map("websites")
}

model WebPage {
  id          String   @id @default(cuid())
  websiteId   String   @map("website_id")
  website     Website  @relation(fields: [websiteId], references: [id])

  url         String
  path        String?
  status      String   @default("pending") // pending | crawled | failed | excluded
  httpStatus  Int?     @map("http_status")

  title       String?
  metaDescription String? @map("meta_description")

  h1          Json?
  h2          Json?
  h3          Json?

  canonical   String?
  metaRobots  String? @map("meta_robots")

  wordCount   Int?     @map("word_count")

  imagesCount      Int? @map("images_count")
  imagesWithoutAlt Int? @map("images_without_alt")

  internalLinksCount Int? @map("internal_links_count")
  externalLinksCount Int? @map("external_links_count")

  structuredDataTypes Json? @map("structured_data_types")
  ogTagsPresent      Json? @map("og_tags_present")
  topKeywords        Json? @map("top_keywords")

  businessAddress   String? @map("business_address")
  businessLatitude  Float?  @map("business_latitude")
  businessLongitude Float?  @map("business_longitude")

  socialLinks Json? @map("social_links")

  jsRenderingUsed      Boolean @default(false) @map("js_rendering_used")
  jsRenderingSuspected Boolean @default(false) @map("js_rendering_suspected")

  mainContent String? @map("main_content")

  errorMessage String? @map("error_message")

  crawledAt DateTime? @map("crawled_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([websiteId, url])
  @@index([websiteId])
  @@map("web_pages")
}

model Audit {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  websiteId      String    @map("website_id")
  website        Website   @relation(fields: [websiteId], references: [id])
  locationId     String?   @map("location_id")
  location       Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  status         String    @default("pending") // pending | running | completed | failed
  opportunities Opportunity[]
  globalScore    Int?      @map("global_score")
  resultJson     Json?     @map("result_json")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  @@map("audits")
}

// A competitor is an external URL an organization wants to benchmark
// against its own site. Deliberately NOT an Audit/Website row: running a
// competitor audit must never emit RC-23's audit.completed event (that
// event means the organization's own site finished auditing), never create
// Opportunities (those are for the org's own site), and never touch
// WebPage (that table is FK'd to the org's own crawled site). It reuses
// AuditRunnerService directly for real, unfabricated scores.
model Competitor {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  websiteId      String    @map("website_id")
  website        Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  url            String
  name           String?
  status         String    @default("pending") // pending | running | completed | failed
  globalScore    Int?      @map("global_score")
  resultJson     Json?     @map("result_json")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  @@unique([websiteId, url])
  @@index([organizationId])
  @@map("competitors")
}

model Opportunity {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  auditId          String   @map("audit_id")
  audit            Audit    @relation(fields: [auditId], references: [id])
  locationId       String?  @map("location_id")
  location         Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  title            String
  description      String
  category         String?
  impactScore      Int      @map("impact_score")
  effortScore      Int      @map("effort_score")
  confidenceScore  Float    @map("confidence_score")
  sourceData       Json?    @map("source_data")
  status           String   @default("open") // open | in_progress | done | ignored
  createdAt        DateTime @default(now()) @map("created_at")

  documents Document[]
  actionItems ActionItem[]

  @@map("opportunities")
}

model Document {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  websiteId      String   @map("website_id")
  website        Website  @relation(fields: [websiteId], references: [id])
  opportunityId  String?  @map("opportunity_id")
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  type           String   // local_page | faq | meta | gbp_post | review_reply | dev_brief | checklist
  title          String
  content        String
  brief          Json?
  revision       Int      @default(1)
  status         String   @default("draft") // draft | edited | validated
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  validationLogs ValidationLog[]
  actionItems    ActionItem[]

  @@index([organizationId, websiteId, updatedAt])
  @@map("documents")
}

model ValidationLog {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  documentId     String    @map("document_id")
  document       Document  @relation(fields: [documentId], references: [id])
  actionType     String    @map("action_type") // publish | update | reply
  platform       String?   // website | gbp | wordpress...
  beforeValue    String?   @map("before_value")
  afterValue     String?   @map("after_value")
  status         String    @default("pending") // pending | approved | rejected
  validatedAt    DateTime? @map("validated_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("validation_logs")
}

model ActionItem {
  id                  String    @id @default(cuid())
  organizationId      String    @map("organization_id")
  organization        Organization @relation(fields: [organizationId], references: [id])
  opportunityId       String?   @map("opportunity_id")
  opportunity         Opportunity? @relation(fields: [opportunityId], references: [id])
  documentId          String?   @map("document_id")
  document            Document? @relation(fields: [documentId], references: [id])
  title               String
  status              String    @default("todo") // todo | in_progress | done | blocked | ignored
  dueDate             DateTime? @map("due_date")
  approvalStatus      String    @default("draft") @map("approval_status") // draft | pending | approved | rejected
  approvalReason      String?   @map("approval_reason")
  executionStatus     String    @default("not_started") @map("execution_status") // not_started | ready | succeeded | failed
  executionEvidence   Json?     @map("execution_evidence")
  verificationAuditId String?   @map("verification_audit_id")
  attemptCount        Int       @default(0) @map("attempt_count")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  executionEvents     ActionExecutionEvent[]

  @@map("action_items")
}

model ActionExecutionEvent {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actionItemId   String       @map("action_item_id")
  actionItem     ActionItem   @relation(fields: [actionItemId], references: [id], onDelete: Cascade)
  userId         String       @map("user_id")
  eventType      String       @map("event_type") // submitted | approved | rejected | execution_succeeded | execution_failed
  idempotencyKey String       @unique @map("idempotency_key")
  payload        Json?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, actionItemId, createdAt])
  @@map("action_execution_events")
}

model Location {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String   // ex: "Orange Analakely"
  address        String?
  city           String?
  country        String?
  phone          String?
  legacyImportKey String? @map("legacy_import_key")
  latitude       Float?
  longitude      Float?

  // Horaires normaux + exceptions (jours fériés, fermetures ponctuelles)
  // structure libre en JSON pour l'instant, à typer plus tard si besoin
  openingHours   Json?    @map("opening_hours")

  isPrimary      Boolean  @default(true) @map("is_primary")
  status         String   @default("active") // active | inactive

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Schema/migration drift fix (no DB change, no new migration): the FK
  // constraints on audits.location_id and opportunities.location_id have
  // always been ON DELETE SET NULL (see
  // prisma/migrations/20260827144755_add_locations/migration.sql) — this
  // schema never declared it, so `prisma migrate dev` would eventually
  // propose reverting that constraint. DELETE /locations/:id was never
  // actually unsafe: Postgres already detaches audits/opportunities
  // instead of blocking the delete.
  audits         Audit[]
  opportunities  Opportunity[]
  googleBusinessProfileLocations GoogleBusinessProfileLocation[]

  @@unique([organizationId, legacyImportKey])
  @@map("locations")
}

// RC-20 — Ops Automation Core.
// Architecture: Trigger -> Rule/Condition -> Workflow (steps) -> Approval
// (optional) -> Execution -> Evidence -> History.
//
// `scope` separates today's single case (ORGANIZATION — a PME automating
// its own ROBIA operations) from ROBIA_INTERNAL (ROBIA staff operating on
// ROBIA itself) without building the future PARTNER/PROGRAM/COHORT scopes
// (Orange Digital Center / Orange Formation) yet — see
// docs/RC20_OPS_AUTOMATION_CORE.md.
model Automation {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope            String   @default("ORGANIZATION") // ROBIA_INTERNAL | ORGANIZATION
  name             String
  description      String?
  enabled          Boolean  @default(false)
  // Structured condition tree (see src/ops-automation/condition-engine.ts).
  // Deterministic, allowlisted operators only — never a dynamic expression.
  conditions       Json?
  // Ordered list of { actionType: string, input?: Json } — actionType must
  // resolve against the Ops action registry (src/ops-automation/actions);
  // an unregistered actionType is rejected at creation time, not at run time.
  steps            Json
  requiresApproval Boolean  @default(true) @map("requires_approval")
  createdById      String   @map("created_by_id")
  createdBy        User     @relation(fields: [createdById], references: [id])
  lastRunAt        DateTime? @map("last_run_at")
  nextRunAt        DateTime? @map("next_run_at")
  // RC-25 review fix: a lease on the in-flight scheduled claim for
  // `nextRunAt`. Null when no claim is in flight. Set the instant a
  // dispatcher instance claims this automation's due occurrence; cleared
  // only once that occurrence's run has been durably created (or the
  // automation turned out to be no longer eligible) — never at claim
  // time. `nextRunAt` itself is NOT advanced until that same moment, so a
  // crash between claim and run creation leaves nextRunAt unchanged: the
  // occurrence is never lost, only delayed until the lease goes stale
  // (see AutomationSchedulerService.SCHEDULED_CLAIM_LEASE_MS) and another
  // instance reclaims it with the exact same scheduledFor/dedupKey.
  scheduledClaimedAt DateTime? @map("scheduled_claimed_at")
  // Non-sensitive metadata only (e.g. UI hints) — never tokens/secrets.
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  trigger AutomationTrigger?
  runs    AutomationRun[]

  @@index([organizationId])
  // RC-25: serves AutomationSchedulerService's periodic due-set scan
  // (WHERE enabled = true AND next_run_at <= now).
  @@index([enabled, nextRunAt])
  @@map("automations")
}

model AutomationTrigger {
  id             String   @id @default(cuid())
  automationId   String   @unique @map("automation_id")
  automation     Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  type           String   // manual | scheduled | event
  cronExpression String?  @map("cron_expression") // for type: scheduled
  // IANA zone (e.g. "Indian/Antananarivo", "Europe/Paris", "UTC") the
  // cronExpression is evaluated in — never inferred from the org's
  // city/country. Persisted invariant (RC-25 hardening fix): non-null (UTC
  // by default) for a `scheduled` trigger, always null for `event`/`manual`
  // — a residual value from a prior scheduled trigger is never carried over
  // when a trigger's type changes. See AutomationsService's
  // resolveTriggerTimezone() and RC25's cron-schedule.ts for the strict
  // cron/timezone validation (Intl-based, not left to cron-parser's own
  // unclear error on an invalid zone).
  timezone       String?  @map("timezone")
  eventType      String?  @map("event_type")      // for type: event, e.g. "audit.completed"
  config         Json?    // extra, non-sensitive trigger config
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // A DB-level CHECK constraint (`automation_triggers_timezone_by_type_check`)
  // also enforces the timezone invariant documented above — added via raw
  // SQL in the 20260917090000_automation_trigger_timezone_invariant
  // migration, since this Prisma version's schema DSL has no `@@check`
  // attribute (it errors "Attribute not known: @check" without a preview
  // feature this project doesn't otherwise need) to represent it here. The
  // migration file is the source of truth for that constraint; this comment
  // exists so it isn't missed on a future schema read.
  @@map("automation_triggers")
}

// One ingested event, deduplicated by (organizationId, eventKey) before it
// is ever matched against any automation's trigger/conditions — this is
// RC-20's "système d'événements". RC20 exposes the ingestion/service, but
// nothing in this PR calls it from AuditsService/MetaService/etc.: existing
// modules are not modified to emit these events yet.
model AutomationEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType      String   @map("event_type")
  eventKey       String   @map("event_key")
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  runs AutomationRun[]

  // Scoped by eventType, not just eventKey: an eventKey is only guaranteed
  // unique within its own event type (e.g. an audit id and an unrelated
  // integration id could coincidentally collide as strings). Without this,
  // reusing the same eventKey for a different eventType would silently
  // return the wrong row — the wrong payload — to whatever automations
  // match the new type (see AutomationsService.getOrCreateEvent()).
  @@unique([organizationId, eventType, eventKey])
  @@index([organizationId, eventType, createdAt])
  @@map("automation_events")
}

model AutomationRun {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automationId     String   @map("automation_id")
  automation       Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status           String   @default("queued") // queued | running | waiting_approval | succeeded | failed | cancelled | skipped
  triggerType      String   @map("trigger_type") // manual | scheduled | event
  sourceEventId    String?  @map("source_event_id")
  sourceEvent      AutomationEvent? @relation(fields: [sourceEventId], references: [id])
  // Idempotency key for this run, e.g. `${automationId}:manual:${ts}` or
  // `${automationId}:event:${eventKey}` — a duplicate never creates a
  // second row (see AutomationsService.startRun()).
  dedupKey         String   @map("dedup_key")
  triggeredById    String?  @map("triggered_by_id")
  triggeredBy      User?    @relation("AutomationRunTriggeredBy", fields: [triggeredById], references: [id])
  requiresApproval Boolean  @default(false) @map("requires_approval")
  approvalStatus   String?  @map("approval_status") // pending | approved | rejected
  approvedById     String?  @map("approved_by_id")
  approvedBy       User?    @relation("AutomationRunApprovedBy", fields: [approvedById], references: [id])
  approvalReason   String?  @map("approval_reason")
  approvedAt       DateTime? @map("approved_at")
  startedAt        DateTime? @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  // Always passed through redactSensitive() before being written — never a
  // raw error object that could carry a token/secret.
  errorMessage     String?  @map("error_message")
  // Sanitized snapshot of the condition-evaluation context at trigger time.
  context          Json?
  // Immutable snapshot of the automation's steps (canonical/allowlisted
  // input only) taken at trigger time. executeSteps() runs this, never the
  // automation's current (possibly since-edited) `steps` — otherwise an
  // approver could unknowingly execute different actions than the ones
  // that were actually reviewed before approval.
  plannedSteps     Json?    @map("planned_steps")
  createdAt        DateTime @default(now()) @map("created_at")

  steps AutomationStepRun[]
  notificationDeliveries NotificationDelivery[]

  @@unique([organizationId, dedupKey])
  @@index([organizationId, automationId, createdAt])
  @@map("automation_runs")
}

model AutomationStepRun {
  id         String   @id @default(cuid())
  runId      String   @map("run_id")
  run        AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence   Int
  actionType String   @map("action_type")
  input      Json?
  status     String   @default("queued") // queued | running | succeeded | failed | skipped | cancelled | retry_scheduled
  // Action-produced evidence (redacted before persisting).
  evidence   Json?
  // Cleaned/redacted error text — never a raw stack trace or exception object.
  error      String?
  // RC-27 — automatic step-level retries. Incremented atomically at the
  // start of every attempt (the initial synchronous one included), never at
  // finalize time — so a crash mid-attempt still counts as spent, the same
  // discipline as NotificationDelivery.attemptCount (RC-26). Bounded by
  // MAX_STEP_ATTEMPTS (see step-retry-policy.ts).
  attemptCount Int @default(0) @map("attempt_count")
  // When status='retry_scheduled', the instant AutomationStepRetryDispatcherService
  // may next attempt this step again. Null otherwise.
  nextAttemptAt DateTime? @map("next_attempt_at")
  // A lease on an in-flight attempt — mirrors Automation.scheduledClaimedAt
  // (RC-25) and NotificationDelivery.claimedAt (RC-26). RC-27 hardening: now
  // set on *every* attempt, including the first synchronous one (see
  // AutomationsService.runStepsFrom()) — a crash mid-attempt must always be
  // recoverable, not only a crash mid-retry. Null once no attempt is in
  // flight.
  claimedAt  DateTime? @map("claimed_at")
  // RC-27 hardening — an opaque token minted fresh for each individual
  // attempt (first or retried), set together with claimedAt. Every
  // conditional "did I still hold the claim when this attempt finished"
  // check gates on `claimToken` matching, never on a specific `claimedAt`
  // timestamp — a timestamp can coincidentally collide or (if a lease were
  // ever extended by a heartbeat) drift, an opaque per-attempt token
  // cannot. Null once no attempt is in flight.
  claimToken String? @map("claim_token")
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  createdAt  DateTime @default(now()) @map("created_at")

  notificationDeliveries NotificationDelivery[]

  @@unique([runId, sequence])
  // Serves AutomationStepRetryDispatcherService's periodic due-set scan.
  @@index([status, nextAttemptAt])
  @@map("automation_step_runs")
}

// RC-26 — Notification Delivery Foundation. A durable, retryable record of
// one attempt to deliver one notification (today: email only) to one user.
// Created exclusively by OpsActionsRegistryService's
// robia.notification.send_email action — never directly by a controller,
// and never with a caller-supplied recipient address (see that action's own
// doc comment). NotificationDispatcherService (this module) is the only
// thing that ever attempts the actual send, on its own schedule; creating a
// row here never sends anything by itself.
model NotificationDelivery {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Resolved server-side only, from Automation.createdById — see the
  // action's own validation. Never a caller-supplied address.
  recipientUserId String  @map("recipient_user_id")
  recipient      User     @relation(fields: [recipientUserId], references: [id])
  channel        String   @default("email")
  // Must be one of NOTIFICATION_TEMPLATES' own keys (see
  // notification-templates.ts) — enforced at creation time, not just at
  // send time.
  templateKey    String   @map("template_key")
  // Already validated against the template's own declared variables
  // (unknown keys rejected, values size-bounded, header-injection
  // characters rejected) before this row is ever created — see
  // notification-templates.ts's renderTemplate(). Never sensitive: this is
  // what a template placeholder resolves to, not a secret.
  templateData   Json     @map("template_data")
  // pending -> processing -> sent
  //                        -> retry_scheduled -> processing -> ...
  //                        -> dead_letter
  status         String   @default("pending")
  // Unique per organization — a repeat call for the same automation run +
  // step (see NotificationsService.createEmailDelivery()) always returns
  // the same row instead of creating a second delivery.
  idempotencyKey String   @map("idempotency_key")
  attemptCount   Int      @default(0) @map("attempt_count")
  nextAttemptAt  DateTime @default(now()) @map("next_attempt_at")
  // Lease on the in-flight claim — see NotificationDispatcherService, the
  // same two-phase claim-with-lease pattern as RC-25's
  // AutomationSchedulerService (Automation.scheduledClaimedAt). Null when
  // no claim is in flight.
  claimedAt      DateTime? @map("claimed_at")
  providerMessageId String? @map("provider_message_id")
  // Always passed through redactSensitive() before being written — never a
  // raw error object, SMTP response body, or anything that could carry a
  // credential.
  lastError      String?  @map("last_error")
  sentAt         DateTime? @map("sent_at")
  automationRunId String? @map("automation_run_id")
  automationRun  AutomationRun? @relation(fields: [automationRunId], references: [id], onDelete: SetNull)
  automationStepRunId String? @map("automation_step_run_id")
  automationStepRun AutomationStepRun? @relation(fields: [automationStepRunId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, idempotencyKey])
  // Serves NotificationDispatcherService's periodic claim scan.
  @@index([status, nextAttemptAt])
  // Serves GET /ops/notifications (list, most recent first).
  @@index([organizationId, createdAt])
  @@map("notification_deliveries")
}

// RC-29 — Orange Digital Center candidature workflow: programs, cohort-style
// applications, documents, deterministic completeness/screening, proposed
// (AI/reviewer) vs. final (human) scores, and an append-only decision
// history. The one rule every piece of this domain exists to enforce:
// nothing here — no automation, no action, no scheduled reminder — ever
// writes `OdcApplication.status` to accepted/rejected/waitlisted. Only
// OdcApplicationsService.decide() does, and only for a human caller. See
// docs/RC29_ODC_CANDIDATURES.md.

model OdcProgram {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slug             String
  name             String
  description      String?
  status           String   @default("draft") // draft | open | closed | archived
  opensAt          DateTime? @map("opens_at")
  closesAt         DateTime? @map("closes_at")
  requireDualReview Boolean @default(false) @map("require_dual_review")
  // Indicative only — decide() never reads this to auto-apply a decision;
  // see OdcApplicationsService.decide().
  decisionThreshold Int?    @map("decision_threshold")
  createdById      String   @map("created_by_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  fields       OdcField[]
  criteria     OdcCriterion[]
  docTypes     OdcDocumentType[]
  applications OdcApplication[]
  outreaches   OdcOutreach[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("odc_programs")
}

// One row per answer field a program's candidature form collects (name,
// motivation letter, ...). `required` drives OdcApplicationsService's
// deterministic completeness check — never the AI, never a heuristic.
model OdcField {
  id        String @id @default(cuid())
  programId String @map("program_id")
  program   OdcProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  key       String
  label     String
  required  Boolean @default(false)
  fieldType String  @map("field_type") // text | longtext | number | date | select
  options   Json?
  sortOrder Int     @default(0) @map("sort_order")

  @@unique([programId, key])
  @@map("odc_fields")
}

// One row per scoring criterion a program's candidatures are evaluated
// against. `weight` and `maxPoints` are inputs to the weighted-sum total in
// odc-completeness.ts — never enforced as a hard cap by the database itself.
model OdcCriterion {
  id          String @id @default(cuid())
  programId   String @map("program_id")
  program     OdcProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  key         String
  label       String
  description String?
  weight      Int     @default(1)
  maxPoints   Int     @default(5) @map("max_points")
  required    Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")
  scoreLines  OdcScoreLine[]

  @@unique([programId, key])
  @@map("odc_criteria")
}

// One row per required (or optional) supporting-document type a program's
// candidatures must attach (ID card, CV, ...). `required` drives the same
// deterministic completeness check as OdcField.required.
model OdcDocumentType {
  id        String @id @default(cuid())
  programId String @map("program_id")
  program   OdcProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  key       String
  label     String
  required  Boolean @default(true)
  mimeAllow String[] @default(["application/pdf"]) @map("mime_allow")
  documents OdcDocument[]

  @@unique([programId, key])
  @@map("odc_document_types")
}

// A candidate as a plain, staff/form-entered record (v1 has no public
// candidate portal or login — see docs/RC29_ODC_CANDIDATURES.md's "Acteurs"
// section). `userId` is an optional forward-compatible hook for a future
// portal; nothing in RC-29 reads or writes it.
model OdcApplicant {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  displayName    String @map("display_name")
  email          String?
  phone          String?
  userId         String? @map("user_id")
  createdAt      DateTime @default(now()) @map("created_at")
  applications   OdcApplication[]

  @@index([organizationId, email])
  @@map("odc_applicants")
}

model OdcApplication {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String @map("program_id")
  program        OdcProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  applicantId    String @map("applicant_id")
  applicant      OdcApplicant @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  status         String @default("draft")
  // draft | submitted | screening | incomplete | in_review | waitlisted |
  // accepted | rejected | withdrawn — see OdcApplicationsService for the
  // transition table. accepted/rejected/waitlisted are only ever written by
  // decide(), never by an automation/action.
  answers        Json   @default("{}")
  proposedTotal  Int?   @map("proposed_total")
  finalTotal     Int?   @map("final_total")
  // Written only by robia.odc.prepare_application_summary — a draft for a
  // human to read, never a decision input.
  summaryDraft   String? @map("summary_draft")
  // string[] of "field:<key>" / "document:<key>" — see odc-completeness.ts.
  // Null once complete; never an empty-vs-missing ambiguity since a
  // completeness check always (re)writes this to either a non-empty array
  // or null.
  missing        Json?
  submittedAt    DateTime? @map("submitted_at")
  decidedAt      DateTime? @map("decided_at")
  // Plain id, no relation: decide()'s own actor. See decidedBy below for
  // the actual FK — kept as a separate scalar so it round-trips through the
  // same create/update `data` shape as every other plain-id field here.
  decidedById    String? @map("decided_by_id")
  decidedBy      User?    @relation(fields: [decidedById], references: [id])
  decisionReason String? @map("decision_reason")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  documents  OdcDocument[]
  scoreLines OdcScoreLine[]
  events     OdcHistoryEvent[]
  outreaches OdcOutreach[]

  @@unique([programId, applicantId])
  @@index([organizationId, status])
  @@map("odc_applications")
}

// Metadata only — never a binary blob in this repo/database. `storageKey`
// is optional (v1 may stub an upload as `pending_upload`, no real storage
// backend wired up yet); `status` starts at `received` only when the
// service is given a `storageKey` at creation time, `pending_upload`
// otherwise — see OdcApplicationsService.addDocument().
// RC-33 hardening — multiple-documents policy: atomic replacement, enforced
// by @@unique([applicationId, documentTypeId]) below. At most one document
// row can ever exist per (application, document type) — a new upload
// (OdcApplicationsService.addUploadedDocument()) atomically deletes
// whatever occupied that slot before creating its own row, in the same
// transaction, so there is never a moment with zero or two rows for that
// slot. This also removes any "which one is current" ambiguity at the
// source: a caller (frontend included) can never need to pick among
// several documents of the same type by createdAt or any other order,
// because there is structurally only ever one.
model OdcDocument {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  applicationId  String @map("application_id")
  application    OdcApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documentTypeId String @map("document_type_id")
  documentType   OdcDocumentType @relation(fields: [documentTypeId], references: [id])
  originalName   String @map("original_name")
  mimeType       String @map("mime_type")
  sizeBytes      Int    @map("size_bytes")
  storageKey     String? @map("storage_key")
  status         String @default("received") // pending_upload | received | rejected
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([applicationId, documentTypeId])
  @@index([organizationId, applicationId])
  @@map("odc_documents")
}

// One row per (application, criterion). `proposedPoints` (AI or reviewer)
// and `finalPoints` (human, via PATCH .../scores) are tracked independently
// so a reviewer can see and correct an AI proposal without ever losing it.
// See odc-completeness.ts for how these roll up into
// OdcApplication.proposedTotal/finalTotal (null, never 0, while any
// required criterion's line is unset).
model OdcScoreLine {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  applicationId  String @map("application_id")
  application    OdcApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  criterionId    String @map("criterion_id")
  criterion      OdcCriterion @relation(fields: [criterionId], references: [id])
  proposedPoints Int?   @map("proposed_points")
  proposedBy     String @default("ai") @map("proposed_by") // ai | reviewer
  finalPoints    Int?   @map("final_points")
  rationale      String?
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([applicationId, criterionId])
  @@map("odc_score_lines")
}

// Append-only. No update/delete route exists for this model — every status
// transition (submit, screening outcome, decide, withdraw) writes exactly
// one new row here, never mutates an existing one.
model OdcHistoryEvent {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  applicationId  String @map("application_id")
  application    OdcApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorUserId    String? @map("actor_user_id")
  eventType      String @map("event_type")
  fromStatus     String? @map("from_status")
  toStatus       String? @map("to_status")
  payload        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, applicationId, createdAt])
  @@map("odc_history_events")
}

// RC-31 — sequential, human-approved candidate emails. Recipient address
// is always resolved server-side from OdcApplicant.email — never accepted
// from the client. Sending never writes accepted/rejected/waitlisted.
model OdcOutreach {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programId      String   @map("program_id")
  program        OdcProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  applicationId  String   @unique @map("application_id")
  application    OdcApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sortOrder      Int      @map("sort_order")
  // queued | sent | failed | skipped
  status         String   @default("queued")
  templateKey    String   @default("odc_candidate_invite") @map("template_key")
  approvedById   String?  @map("approved_by_id")
  approvedBy     User?    @relation(fields: [approvedById], references: [id])
  sentAt         DateTime? @map("sent_at")
  lastError      String?  @map("last_error")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([organizationId, programId, sortOrder])
  @@map("odc_outreaches")
}
