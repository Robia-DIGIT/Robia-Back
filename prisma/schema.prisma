// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
  //directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  provider     String   @default("email")
  phone        String?
  company      String?
  bio          String?
  createdAt    DateTime @default(now()) @map("created_at")

  organizations Organization[]
  validationLogs ValidationLog[]

  @@map("users")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  sector    String?
  city      String?
  country   String?
  ownerId   String   @map("owner_id")
  owner     User     @relation(fields: [ownerId], references: [id])
  websites  Website[]
  audits    Audit[]
  opportunities Opportunity[]
  documents     Document[]
  validationLogs ValidationLog[]
  actionItems    ActionItem[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("organizations")
}

model Website {
  id            String   @id @default(cuid())
  organizationId String  @map("organization_id")
  organization  Organization @relation(fields: [organizationId], references: [id])
  url           String
  domain        String?
  status        String   @default("pending") // pending | valid | unreachable
  lastCheckedAt DateTime? @map("last_checked_at")
  createdAt     DateTime @default(now()) @map("created_at")

  audits Audit[]

  @@unique([organizationId, url])
  @@map("websites")  
}

model Audit {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  websiteId      String    @map("website_id")
  website        Website   @relation(fields: [websiteId], references: [id])
  status         String    @default("pending") // pending | running | completed | failed
  opportunities Opportunity[]
  globalScore    Int?      @map("global_score")
  resultJson     Json?     @map("result_json")
  errorMessage   String?   @map("error_message")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  @@map("audits")
}

model Opportunity {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id])
  auditId          String   @map("audit_id")
  audit            Audit    @relation(fields: [auditId], references: [id])
  title            String
  description      String
  category         String?
  impactScore      Int      @map("impact_score")
  effortScore      Int      @map("effort_score")
  confidenceScore  Float    @map("confidence_score")
  sourceData       String?  @map("source_data")
  status           String   @default("open") // open | in_progress | done | ignored
  createdAt        DateTime @default(now()) @map("created_at")

  documents Document[]
  actionItems ActionItem[]

  @@map("opportunities")
}

model Document {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  opportunityId  String   @map("opportunity_id")
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  type           String   // local_page | faq | meta | gbp_post | review_reply | dev_brief | checklist
  title          String
  content        String
  status         String   @default("draft") // draft | edited | validated
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  validationLogs ValidationLog[]
  actionItems    ActionItem[]

  @@map("documents")
}

model ValidationLog {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id])
  documentId     String    @map("document_id")
  document       Document  @relation(fields: [documentId], references: [id])
  actionType     String    @map("action_type") // publish | update | reply
  platform       String?   // website | gbp | wordpress...
  beforeValue    String?   @map("before_value")
  afterValue     String?   @map("after_value")
  status         String    @default("pending") // pending | approved | rejected
  validatedAt    DateTime? @map("validated_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("validation_logs")
}

model ActionItem {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  opportunityId  String?   @map("opportunity_id")
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  documentId     String?   @map("document_id")
  document       Document? @relation(fields: [documentId], references: [id])
  title          String
  status         String    @default("todo") // todo | in_progress | done | blocked | ignored
  dueDate        DateTime? @map("due_date")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("action_items")
}